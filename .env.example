# Copy to .env.local and fill in real values. .env.local is gitignored and
# must never be committed.

# Supabase project (linked dev project for local/dev work). Uses the 2026
# Supabase API key scheme (publishable/secret), not the legacy anon/
# service_role keys -- do not build new code around the legacy key names.
SUPABASE_URL=
# Secret key: full service_role-equivalent Postgres privileges. Server-only/
# admin code exclusively (app/lib/supabase/serviceClient.ts). Never exposed
# to the browser.
SUPABASE_SECRET_KEY=
# Publishable key: low-privilege, safe to expose to a browser in general,
# but not currently used client-side in this slice, so intentionally not
# NEXT_PUBLIC_-prefixed yet. Used server-side by app/lib/auth/managerAuth.ts
# to read a manager's Supabase Auth session.
SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never NEXT_PUBLIC_-prefixed, never exposed to the browser.
PIN_PEPPER=
KIOSK_TOKEN_SECRET=

# Trusted server-side kiosk organization context (V1: exactly one org).
# Never supplied by the browser.
KIOSK_ORGANIZATION_ID=

# Dev-seed script (scripts/dev-seed.ts) only.
ALLOW_DEV_SEED=
# Optional: fixed PINs/credentials for seeded dev/test identities. If unset,
# the script generates random values and prints them once (never persisted
# or committed).
DEV_SEED_EMPLOYEE_1_PIN=
DEV_SEED_EMPLOYEE_2_PIN=
DEV_SEED_EMPLOYEE_3_PIN=
DEV_SEED_MANAGER_PIN=
DEV_SEED_MANAGER_EMAIL=
DEV_SEED_MANAGER_PASSWORD=
# Second dev manager -- for manually testing maker-checker workflows that
# require a different manager to verify/return a document than the one who
# prepared it. Same optional-fixed-or-generated behavior as the first.
DEV_SEED_MANAGER_2_PIN=
DEV_SEED_MANAGER_2_EMAIL=
DEV_SEED_MANAGER_2_PASSWORD=

# Gemini (Milestone 2A.0 -- AI document extraction). Server-only, never
# NEXT_PUBLIC_-prefixed, never exposed to the browser or logged.
GEMINI_API_KEY=
# Optional: overrides the coded default model in app/lib/ai/config.ts.
GEMINI_MODEL=

# Temporary dev-only test harness (app/manager/ai-test/invoice). Must be
# "true" to enable, AND the app refuses to serve this route when
# NODE_ENV=production regardless of this flag -- this is not authentication,
# only a guard against an accidentally-exposed, real-money endpoint.
ALLOW_AI_TEST_PAGE=
