# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# netlify -- local CLI state/build artifacts from deploying the phone
# capture shell page (scripts/deployPhoneCaptureShellToNetlify.ts); never
# generated by this app's own build and must never be picked up by tsc/eslint
.netlify/
netlify.toml

# typescript
*.tsbuildinfo
next-env.d.ts

# generated DEV reset manifests -- operational snapshots produced by
# scripts/reset-gansevoort-dev-operational-data.ts (the script itself IS
# tracked); kept locally for records, never version-controlled
/scripts/manifests/
